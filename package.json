{
	"name": "@ucf/components",
	"version": "0.1.0",
	"description": "A framework-agnostic, React-based component library and testbench for UCF websites and applications",
	"private": true,
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"exports": {
		"./ucf.css": "./dist/ucf.css",
		"./elements.css": "./dist/elements.css",
		"./theme/*": "./dist/theme/*",
		"./stat": {
			"types": "./dist/components/stat/index.d.ts",
			"default": "./dist/components/stat/index.js"
		},
		"./stat/puck": {
			"types": "./dist/components/stat/adapters/puck/config.d.ts",
			"default": "./dist/components/stat/adapters/puck/config.js"
		},
		"./stat/example.json": "./dist/components/stat/example.json",
		"./section": {
			"types": "./dist/components/section/index.d.ts",
			"default": "./dist/components/section/index.js"
		},
		"./section/puck": {
			"types": "./dist/components/section/adapters/puck/config.d.ts",
			"default": "./dist/components/section/adapters/puck/config.js"
		},
		"./degree-finder": {
			"types": "./dist/components/degree-finder/index.d.ts",
			"default": "./dist/components/degree-finder/index.js"
		},
		"./degree-finder/puck": {
			"types": "./dist/components/degree-finder/adapters/puck/config.d.ts",
			"default": "./dist/components/degree-finder/adapters/puck/config.js"
		},
		"./hero": {
			"types": "./dist/components/hero/index.d.ts",
			"default": "./dist/components/hero/index.js"
		},
		"./hero/puck": {
			"types": "./dist/components/hero/adapters/puck/config.d.ts",
			"default": "./dist/components/hero/adapters/puck/config.js"
		},
		"./hero/example.json": "./dist/components/hero/example.json",
		"./primitives/button": {
			"types": "./dist/primitives/button/index.d.ts",
			"default": "./dist/primitives/button/index.js"
		},
		"./primitives/button/puck": {
			"types": "./dist/primitives/button/adapters/puck/config.d.ts",
			"default": "./dist/primitives/button/adapters/puck/config.js"
		},
		"./primitives/button/example.json": "./dist/primitives/button/example.json",
		"./primitives/image": {
			"types": "./dist/primitives/image/index.d.ts",
			"default": "./dist/primitives/image/index.js"
		},
		"./primitives/image/puck": {
			"types": "./dist/primitives/image/adapters/puck/config.d.ts",
			"default": "./dist/primitives/image/adapters/puck/config.js"
		},
		"./primitives/image/example.json": "./dist/primitives/image/example.json",
		"./card": {
			"types": "./dist/components/card/index.d.ts",
			"default": "./dist/components/card/index.js"
		},
		"./card/puck": {
			"types": "./dist/components/card/adapters/puck/config.d.ts",
			"default": "./dist/components/card/adapters/puck/config.js"
		},
		"./card/example.json": "./dist/components/card/example.json",
		"./primitives/heading": {
			"types": "./dist/primitives/heading/index.d.ts",
			"default": "./dist/primitives/heading/index.js"
		},
		"./primitives/heading/puck": {
			"types": "./dist/primitives/heading/adapters/puck/config.d.ts",
			"default": "./dist/primitives/heading/adapters/puck/config.js"
		},
		"./primitives/heading/example.json": "./dist/primitives/heading/example.json",
		"./primitives/paragraph": {
			"types": "./dist/primitives/paragraph/index.d.ts",
			"default": "./dist/primitives/paragraph/index.js"
		},
		"./primitives/paragraph/puck": {
			"types": "./dist/primitives/paragraph/adapters/puck/config.d.ts",
			"default": "./dist/primitives/paragraph/adapters/puck/config.js"
		},
		"./primitives/paragraph/example.json": "./dist/primitives/paragraph/example.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"*.css"
	],
	"peerDependencies": {
		"react": ">=18.3"
	},
	"scripts": {
		"build": "npm run build:tokens && node scripts/build-package.mjs && wp-scripts build",
		"build:tokens": "node scripts/build-tokens.mjs",
		"build:package": "node scripts/build-package.mjs",
		"build:plugins": "npm run build:tokens && wp-scripts build",
		"start": "npm run build:tokens && wp-scripts start",
		"release:temp": "npm run build && node scripts/release-temp.mjs",
		"deploy": "npm run build && node --env-file-if-exists=.env scripts/deploy.mjs",
		"deploy:watch": "node --env-file-if-exists=.env scripts/deploy.mjs --watch",
		"new:component": "node scripts/new-component.mjs",
		"storybook": "npm run build:tokens && storybook dev -p 6006",
		"build:storybook": "npm run build:tokens && storybook build -o storybook-static",
		"test": "wp-scripts test-unit-js --project=unit",
		"test:stories": "wp-scripts test-unit-js --project='storybook:*'",
		"typecheck": "tsc -p tsconfig.json",
		"lint": "npm run lint:js && npm run lint:css && npm run lint:php",
		"lint:js": "wp-scripts lint-js primitives components examples scripts .storybook webpack.config.js",
		"lint:css": "wp-scripts lint-style \"plugins/shared/*.css\" \"primitives/**/*.css\" \"components/**/*.css\" \"examples/**/*.css\" \"styles/**/*.css\"",
		"lint:php": "composer lint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "npm test && npm run typecheck && npm run lint && npm run format:check"
	},
	"devDependencies": {
		"@puckeditor/core": "^0.24.0",
		"@storybook/addon-a11y": "^10.6.5",
		"@storybook/addon-vitest": "^10.6.5",
		"@storybook/react-vite": "^10.6.5",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitest/browser-playwright": "^5.0.5",
		"@vitest/coverage-v8": "^5.0.5",
		"@wordpress/block-editor": "^19.0.0",
		"@wordpress/blocks": "^17.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/scripts": "^37.0.0",
		"copy-webpack-plugin": "^10.2.4",
		"playwright": "^1.64.1",
		"prettier": "npm:wp-prettier@^3.9.6",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"storybook": "^10.6.5",
		"typescript": "^5.9.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
