exports[`ucf-content/hero > example > matches the stored markup snapshot 1`] = `
"<!-- wp:ucf-content/hero {"eyebrow":"Undergraduate admissions","title":"Reach for the stars","description":"Florida’s largest university, with 70,674 students, in Orlando and online.","primaryLabel":"Apply now","primaryHref":"#","secondaryLabel":"Visit campus","secondaryHref":"#","imageSrc":"data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 1200 900%27%3E%3Cdefs%3E%3ClinearGradient id=%27g%27 x1=%270%27 y1=%270%27 x2=%271%27 y2=%271%27%3E%3Cstop offset=%270%27 stop-color=%27%23444%27/%3E%3Cstop offset=%271%27 stop-color=%27%23000%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width=%271200%27 height=%27900%27 fill=%27url(%23g)%27/%3E%3Ccircle cx=%27880%27 cy=%27260%27 r=%27150%27 fill=%27%23ffc904%27/%3E%3C/svg%3E","badgeItems":[{"text":"Orlando, Florida"},{"text":"Founded 1963"},{"text":"70,000+ students"}]} -->
<section class="wp-block-ucf-content-hero alignfull ucf-c ucf-c-hero ucf-composition-gold" data-layout="split" data-height="regular" data-image-side="right" data-image-fill="card" data-split-ratio="even"><div class="ucf-c-hero__inner"><div class="ucf-c-hero__copy" data-align="left"><p class="ucf-c-hero__eyebrow">Undergraduate admissions</p><h1 class="ucf-c-hero__title">Reach for the stars</h1><p class="ucf-c-hero__description">Florida’s largest university, with 70,674 students, in Orlando and online.</p><div class="ucf-c-hero__actions"><a class="ucf-c ucf-c-button" data-variant="fill" href="#">Apply now</a><a class="ucf-c ucf-c-button" data-variant="outline" href="#">Visit campus</a></div></div><div class="ucf-c-hero__media"><img class="ucf-c-hero__image" src="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 1200 900%27%3E%3Cdefs%3E%3ClinearGradient id=%27g%27 x1=%270%27 y1=%270%27 x2=%271%27 y2=%271%27%3E%3Cstop offset=%270%27 stop-color=%27%23444%27/%3E%3Cstop offset=%271%27 stop-color=%27%23000%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width=%271200%27 height=%27900%27 fill=%27url(%23g)%27/%3E%3Ccircle cx=%27880%27 cy=%27260%27 r=%27150%27 fill=%27%23ffc904%27/%3E%3C/svg%3E" alt=""/></div></div></section>
<!-- /wp:ucf-content/hero -->"
`;

