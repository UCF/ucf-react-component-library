// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`EventList > renders: a heading and descriptions 1`] = `"<div class="ucf-c ucf-c-event-list"><h2 class="ucf-c-event-list__heading ucf-c ucf-c-heading">Upcoming events</h2><ul class="ucf-c-event-list__items"><li class="ucf-c-event-list__item"><div class="ucf-c-event-list__date" aria-hidden="true"><span class="ucf-c-event-list__month">Nov</span><span class="ucf-c-event-list__day">6</span></div><div class="ucf-c-event-list__body"><h3 class="ucf-c-event-list__title ucf-c ucf-c-heading"><a href="https://events.ucf.edu/event/4223708/paws-a-tively-stress-free/">PAWS-a-tively Stress Free</a></h3><p class="ucf-c-event-list__meta"><time dateTime="2026-11-06T11:00:00-05:00">Nov. 6, 2026, 11 a.m.</time><span>Counseling and Psychological Services</span></p><p class="ucf-c-event-list__description">Need a stress break as we head into the last few weeks of the semester? Stop by CAPS and meet our therapy dog friends. The dogs will be at CAPS from 11:00 am to 1:00 pm and ready for snuggles.</p></div></li><li class="ucf-c-event-list__item"><div class="ucf-c-event-list__date" aria-hidden="true"><span class="ucf-c-event-list__month">Nov</span><span class="ucf-c-event-list__day">6</span></div><div class="ucf-c-event-list__body"><h3 class="ucf-c-event-list__title ucf-c ucf-c-heading"><a href="https://events.ucf.edu/event/4223733/guest-artist-masterclass-john-bruce-yeh-clarinet/">Guest Artist Masterclass: John Bruce Yeh, clarinet</a></h3><p class="ucf-c-event-list__meta"><time dateTime="2026-11-06T11:30:00-05:00">Nov. 6, 2026, 11:30 a.m.</time><span>PAC-Music, M120: 120</span></p><p class="ucf-c-event-list__description">Please join us at UCF for a clarinet masterclass with the highly regarded and versatile clarinetist John Bruce Yeh, Assistant Principal Clarinet and E-flat Clarinet of the Chicago Symphony Orchestra. Admission is Free.</p></div></li></ul></div>"`;

exports[`EventList > renders: large 1`] = `"<div class="ucf-c ucf-c-event-list" data-size="large"><ul class="ucf-c-event-list__items"><li class="ucf-c-event-list__item"><div class="ucf-c-event-list__date" aria-hidden="true"><span class="ucf-c-event-list__month">Nov</span><span class="ucf-c-event-list__day">6</span></div><div class="ucf-c-event-list__body"><h3 class="ucf-c-event-list__title ucf-c ucf-c-heading"><a href="https://events.ucf.edu/event/4223708/paws-a-tively-stress-free/">PAWS-a-tively Stress Free</a></h3><p class="ucf-c-event-list__meta"><time dateTime="2026-11-06T11:00:00-05:00">Nov. 6, 2026, 11 a.m.</time><span>Counseling and Psychological Services</span></p></div></li><li class="ucf-c-event-list__item"><div class="ucf-c-event-list__date" aria-hidden="true"><span class="ucf-c-event-list__month">Nov</span><span class="ucf-c-event-list__day">6</span></div><div class="ucf-c-event-list__body"><h3 class="ucf-c-event-list__title ucf-c ucf-c-heading"><a href="https://events.ucf.edu/event/4223733/guest-artist-masterclass-john-bruce-yeh-clarinet/">Guest Artist Masterclass: John Bruce Yeh, clarinet</a></h3><p class="ucf-c-event-list__meta"><time dateTime="2026-11-06T11:30:00-05:00">Nov. 6, 2026, 11:30 a.m.</time><span>PAC-Music, M120: 120</span></p></div></li></ul></div>"`;

exports[`EventList > renders: no events, with a message 1`] = `"<div class="ucf-c ucf-c-event-list"><p class="ucf-c-event-list__empty">There are no upcoming events.</p></div>"`;

