{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ucf-content/hero",
	"title": "Hero",
	"category": "ucf",
	"icon": "cover-image",
	"description": "A page-opening band with an image, and its copy and buttons placed inside. A trial port of P1's Hero.",
	"keywords": [ "hero", "banner", "header", "p1" ],
	"textdomain": "ucf-content",
	"attributes": {
		"tone": {
			"type": "string",
			"default": "accent"
		},
		"layout": {
			"type": "string",
			"default": "split"
		},
		"imageSrc": {
			"type": "string",
			"default": ""
		},
		"imageAlt": {
			"type": "string",
			"default": ""
		},
		"imageId": {
			"type": "number",
			"default": 0
		},
		"imageSide": {
			"type": "string",
			"default": "right"
		},
		"imageFill": {
			"type": "string",
			"default": "card"
		},
		"splitRatio": {
			"type": "string",
			"default": "even"
		},
		"contentAlign": {
			"type": "string",
			"default": "left"
		},
		"overlay": {
			"type": "string",
			"default": "gradient right"
		},
		"overlayStrength": {
			"type": "string",
			"default": "medium"
		},
		"height": {
			"type": "string",
			"default": "regular"
		},
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "full" ]
	},
	"editorScript": "file:./index.tsx",
	"style": "file:./style-index.css"
}
