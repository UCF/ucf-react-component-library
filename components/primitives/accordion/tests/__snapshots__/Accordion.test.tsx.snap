exports[`Accordion > renders the same in WordPress and React: defaults 1`] = `"<div role="group" class="ucf-c ucf-c-accordion"><div class="ucf-c-accordion__items"><div class="ucf-c ucf-c-accordion-item"><h3 class="ucf-c-accordion-item__heading"><button type="button" class="ucf-c-accordion-item__toggle"><span class="ucf-c-accordion-item__title">Do I have to send test scores?</span><span class="ucf-c-accordion-item__icon" aria-hidden="true"></span></button></h3><div class="ucf-c-accordion-item__panel"><p>Check the current requirement.</p></div></div><div class="ucf-c ucf-c-accordion-item"><h4 class="ucf-c-accordion-item__heading"><button type="button" class="ucf-c-accordion-item__toggle"><span class="ucf-c-accordion-item__title">How much transfers?</span><span class="ucf-c-accordion-item__icon" aria-hidden="true"></span></button></h4><div class="ucf-c-accordion-item__panel"><p>A Florida A.A. transfers as a block.</p></div></div></div></div>"`;

exports[`Accordion > renders the same in WordPress and React: with an id and a class 1`] = `"<div id="faq" role="group" class="is-featured ucf-c ucf-c-accordion"><div class="ucf-c-accordion__items"><div class="ucf-c ucf-c-accordion-item"><h3 class="ucf-c-accordion-item__heading"><button type="button" class="ucf-c-accordion-item__toggle"><span class="ucf-c-accordion-item__title">Do I have to send test scores?</span><span class="ucf-c-accordion-item__icon" aria-hidden="true"></span></button></h3><div class="ucf-c-accordion-item__panel"><p>Check the current requirement.</p></div></div><div class="ucf-c ucf-c-accordion-item"><h4 class="ucf-c-accordion-item__heading"><button type="button" class="ucf-c-accordion-item__toggle"><span class="ucf-c-accordion-item__title">How much transfers?</span><span class="ucf-c-accordion-item__icon" aria-hidden="true"></span></button></h4><div class="ucf-c-accordion-item__panel"><p>A Florida A.A. transfers as a block.</p></div></div></div></div>"`;
