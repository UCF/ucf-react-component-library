exports[`Section > renders its markup: compact 1`] = `"<section class="ucf-section ucf-composition-light ucf-section--compact"><div class="ucf-section__inner ucf-section__inner--default"><p>Content</p></div></section>"`;

exports[`Section > renders its markup: dark, constrained, cozy 1`] = `"<section class="ucf-section ucf-composition-dark ucf-section--cozy"><div class="ucf-section__inner ucf-section__inner--constrained"><p>Content</p></div></section>"`;

