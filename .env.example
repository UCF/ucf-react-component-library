# Local settings for this machine. Copy this file to .env (never committed) and fill it in.
# Read by `npm run deploy` and `npm run deploy:watch`; a value already set in the shell wins over this file.

# Set either or both. Each is an absolute path.

# The wp-content/plugins folder of a WordPress install: the plugins are copied in.
# Example: /path/to/wordpress/wp-content/plugins
WP_PLUGINS_DIR=

# A folder inside a React site that it installs @ucf/components from: the npm package is copied
# in. The site's package.json lists it as "@ucf/components": "file:./vendor/ucf-components".
# Example: /path/to/site/vendor/ucf-components
PACKAGE_DIR=
