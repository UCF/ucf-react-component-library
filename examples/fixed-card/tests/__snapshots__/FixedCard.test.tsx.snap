exports[`FixedCard > renders the same in WordPress and React: boxed, horizontal, from the media library 1`] = `"<div class="wp-block-ucf-content-fixed-card ucf-c ucf-c-fixed-card" data-variant="boxed" data-layout="horizontal" data-linked=""><div class="ucf-c-fixed-card__body"><h3 class="ucf-c-fixed-card__title"><a class="ucf-c-fixed-card__link" href="#">Bachelor’s degrees</a></h3><p class="ucf-c-fixed-card__meta">Programs · Fall 2026</p><p class="ucf-c-fixed-card__description">Explore majors taught by faculty who put undergraduate teaching first.</p></div><div class="ucf-c-fixed-card__media"><img class="ucf-c-image wp-image-1234" src="https://www.ucf.edu/files/2026/01/students.jpg" alt="Students outside the Student Union" data-ratio="3-2"/></div></div>"`;

