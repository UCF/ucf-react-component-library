	"composition": {
		"$type": "color",
		"$description": "SPEC: the design system's four surfaces (light, alt, dark, gold), plus dark-alt, which is this repo's. A background plus the treatment that says how everything sits on it. Balance light and dark down a page; one gold band per page at most, usually the call to action. SYNC: the block theme's $compositions in src/scss/_compositions.scss and ucf_theme_register_composition_styles() in includes/block-styles.php. Each composition names two others in $extensions: `bar`, what a control bar set in it uses (the Degree Finder's footer: Dark on light and gold sections, Light Alt on dark ones, so the bar always contrasts with the band above it), and optionally `panel`, what objects set on it use (Bold Gold's panels are Light Alt).",
		"light": {
			"$extensions": {
				"edu.ucf": {
					"name": "Light - Default",
					"treatment": "light",
					"bar": "dark"
				}
			},
			"background": {
				"$value": "{color.white}"
			},
			"text": {
				"$value": "{color.black}"
			}
		},
		"alt": {
			"$extensions": {
				"edu.ucf": {
					"name": "Light Alt",
					"treatment": "light",
					"bar": "dark"
				}
			},
			"background": {
				"$value": "{color.gray-050}"
			},
			"text": {
				"$value": "{color.black}"
			},
			"raised": {
				"$value": "{color.white}",
				"$description": "FIX: a panel on this field is white, not the treatment's gray-050 — the design system's boxed card uses `surface-alt`, which on its own Alt surface is the ground itself, and the box disappears. Found on the first page built from it."
			},
			"field": {
				"$value": "{color.gray-050}",
				"$description": "WHY gray-050, not the treatment's white: Light Alt's raised band is white, so white cards on it would show only by their outline. Its own field color sets them apart."
			}
		},
		"dark": {
			"$extensions": {
				"edu.ucf": {
					"name": "Dark",
					"treatment": "dark",
					"bar": "alt"
				}
			},
			"background": {
				"$value": "{color.black}"
			},
			"text": {
				"$value": "{color.white}"
			}
		},
		"dark-alt": {
